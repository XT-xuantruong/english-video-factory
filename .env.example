# Main paths
EXCEL_PATH=data/content.xlsx
OUTPUT_DIR=output
TEMPLATES_DIR=templates
ASSETS_DIR=assets

# Python TTS service
TTS_SERVICE_URL=http://127.0.0.1:8124
TTS_TIMEOUT_MS=600000

# VieNeu v3 Turbo — Vietnamese
VIENEU_VOICE=Trúc Ly
VIENEU_STYLE=tu_nhien
VIENEU_BACKEND=onnx
VIENEU_PRECISION=int8
VIENEU_RATE=0.94

# Edge TTS — English
EDGE_VOICE=en-US-AvaNeural
EDGE_RATE=-10%
EDGE_PITCH=+0Hz
EDGE_TTS_CONCURRENCY=4
SCRIPT_ENGLISH_RATE=-12%

# Rendering
RENDER_CONCURRENCY=1
HYPERFRAMES_QUALITY=standard
HYPERFRAMES_WORKERS=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Brand and shared intro/outro
BRAND_NAME=English Mỗi Ngày
SERIES_LABEL=TỪ VỰNG MỖI NGÀY
OUTRO_CTA=Hãy đặt một câu với từ vừa học trong phần bình luận nhé.
OUTRO_HANDLE=Theo dõi · Lưu · Ôn lại

# Vocabulary recall branded outro
RECALL_OUTRO_CTA=Hãy follow kênh và thả tim để cập nhật thêm nhiều bài học mới nhé.
CHANNEL_LOGO_URL=
CHANNEL_LOGO_TEXT=EMN
